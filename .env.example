# Copy to .env (never committed). All values optional for fixture-mode ingest.
NODE_ENV=development

# Postgres (Supabase or Azure PG). Leave empty to run ingest in dry-run mode.
DATABASE_URL=

# Tjek / eTilbudsavis. Only used when source_registry marks tjek as `approved`.
TJEK_API_KEY=

# Salling Group developer portal bearer token. Only used when marked `approved`.
SALLING_BEARER_TOKEN=

# Default timezone for ingest scheduling
TZ=Europe/Copenhagen

# Web app: path to an ingest snapshot (default: <repo>/data/offers/latest.json). Absent → fixtures.
OFFERS_SNAPSHOT=
