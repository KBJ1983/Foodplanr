{
  "name": "madplan-platform",
  "private": true,
  "version": "0.0.1",
  "description": "Chain-independent Danish meal-plan platform. Phase 0 scaffold.",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "ingest": "tsx apps/ingest/src/cli.ts",
    "dev:web": "pnpm --filter @madplan/web dev",
    "build:web": "pnpm --filter @madplan/web build",
    "typecheck:web": "pnpm --filter @madplan/web typecheck",
    "db:generate": "pnpm --filter @madplan/db run generate",
    "db:migrate": "pnpm --filter @madplan/db run migrate"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vitest": "^4.0.0"
  }
}
